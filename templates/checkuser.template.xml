<?xml version="1.0" encoding="utf-8"?>
<!--
  Template SOAP per autenticazione al Portale Automobilista.
  Token sostituiti a runtime: _MYLOGIN_ e _MYPASSWORD_
  NON modificare i token. Il contenuto NON viene mai loggato.
-->
<soapenv:Envelope
    xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/"
    xmlns:wsse="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-secext-1.0.xsd"
    xmlns:tns="http://permessoProvvisorioGuida.services.prenotapatente.motorizzazione.it">
  <soapenv:Header>
    <wsse:Security soapenv:mustUnderstand="1">
      <wsse:UsernameToken>
        <wsse:Username>_MYLOGIN_</wsse:Username>
        <wsse:Password Type="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-username-token-profile-1.0#PasswordText">_MYPASSWORD_</wsse:Password>
      </wsse:UsernameToken>
    </wsse:Security>
  </soapenv:Header>
  <soapenv:Body>
    <tns:stampaPermessoProvvisorio>
      <tns:login>_MYLOGIN_</tns:login>
    </tns:stampaPermessoProvvisorio>
  </soapenv:Body>
</soapenv:Envelope>
